{
    "editor.minimap.enabled": false,
    "editor.formatOnSave": true,
    "workbench.editorAssociations": {
        "*.ipynb": "jupyter-notebook"
    },
    "editor.fontSize": 11.5,
    "notebook.cellToolbarLocation": {
        "default": "right",
        "jupyter-notebook": "left"
    },
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
    },
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.diagnosticMode": "workspace",
    "rust-analyzer.inlayHints.typeHints.enable": false,
    "github.copilot.enable": {
        "*": true,
        "yaml": false,
        "plaintext": false,
        "markdown": false,
        "properties": false,
        "rust": false
    },
    "cmake.configureOnOpen": true,
    "workbench.editor.untitled.hint": "hidden",
    "errorLens.enabled": false,
    "settings.cycle": [
        {
            "id": "formatOnSave",
            "overrideWorkspaceSettings": true,
            "values": [
                {
                    "editor.formatOnSave": true
                },
                {
                    "editor.formatOnSave": false
                }
            ]
        },
        {
            "id": "errorLens",
            "overrideWorkspaceSettings": true,
            "values": [
                {
                    "errorLens.enabled": true
                },
                {
                    "errorLens.enabled": false
                }
            ]
        }
    ],
    "go.toolsManagement.autoUpdate": true,
    "workbench.activityBar.location": "hidden",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "editor.inlineSuggest.edits.showCollapsed": true,
    "editor.inlineSuggest.showToolbar": "never",
    "cursorpyright.analysis.typeCheckingMode": "basic",
    "security.promptForLocalFileProtocolHandling": false,
    "cursor.cpp.disabledLanguages": [
        "markdown",
        "plaintext",
        "python"
    ],
    "ruff.path": [
        "/Users/catherine/.local/bin/ruff"
    ],
    // Files opened from outside the window's workspace folder (e.g. a wormhole link into another
    // worktree) don't get the project's pyproject.toml, so ruff falls back to these editor
    // settings. Keep project config first, and make the fallback match the dagster repos (100).
    "ruff.configurationPreference": "filesystemFirst",
    "ruff.lineLength": 100
}
